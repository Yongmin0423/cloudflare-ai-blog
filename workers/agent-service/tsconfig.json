{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@cloudflare-ai-blog/database": [
        "../../packages/database/src/management.ts"
      ],
      "@cloudflare-ai-blog/database/public-blog": [
        "../../packages/database/src/public-blog.ts"
      ],
      "@cloudflare-ai-blog/shared": ["../../packages/shared/src/management.ts"]
    }
  },
  "include": ["src/**/*.ts", "cloudflare-env.d.ts"]
}
