{
  "name": "cloudflare-ai-blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "dev:blog": "pnpm --filter @cloudflare-ai-blog/blog-web run dev",
    "dev:admin": "pnpm --filter @cloudflare-ai-blog/admin-web run dev",
    "dev:agent": "pnpm --filter @cloudflare-ai-blog/agent-service run dev",
    "build:agent": "pnpm --filter @cloudflare-ai-blog/agent-service run build:worker",
    "build": "pnpm -r --workspace-concurrency=1 --filter \"./apps/*\" run build",
    "start": "pnpm --parallel --filter \"./apps/*\" run start",
    "lint": "pnpm -r --workspace-concurrency=1 --filter \"./apps/*\" run lint",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "typecheck": "pnpm -r --workspace-concurrency=1 --filter \"./apps/*\" run typecheck",
    "build:worker": "pnpm -r --workspace-concurrency=1 --filter \"./apps/*\" run build:worker",
    "build:blog": "pnpm --filter @cloudflare-ai-blog/blog-web run build:worker",
    "build:admin": "pnpm --filter @cloudflare-ai-blog/admin-web run build:worker",
    "preview": "pnpm run build:worker && pnpm run preview:worker",
    "preview:worker": "pnpm --parallel --filter \"./apps/*\" run preview:worker",
    "preview:blog": "pnpm --filter @cloudflare-ai-blog/blog-web run preview:worker",
    "preview:admin": "pnpm --filter @cloudflare-ai-blog/admin-web run preview:worker",
    "deploy:blog": "pnpm --filter @cloudflare-ai-blog/blog-web run deploy",
    "deploy:admin": "pnpm --filter @cloudflare-ai-blog/admin-web run deploy",
    "cf-typegen": "pnpm -r --workspace-concurrency=1 --filter \"./apps/*\" run cf-typegen",
    "db:check": "node scripts/run-tool.mjs wrangler d1 execute DB --config apps/admin-web/wrangler.jsonc --local --persist-to .wrangler/state --command \"SELECT 1 AS connected\"",
    "db:check:remote": "node scripts/run-tool.mjs wrangler d1 execute DB --config apps/admin-web/wrangler.jsonc --remote --command \"SELECT 1 AS connected\"",
    "db:test:schema": "node --test packages/database/tests/schema.test.mjs",
    "db:migrate:local": "node scripts/run-tool.mjs wrangler d1 migrations apply cloudflare-ai-blog --config apps/admin-web/wrangler.jsonc --local --persist-to .wrangler/state",
    "db:test:local": "node scripts/run-tool.mjs wrangler d1 execute cloudflare-ai-blog --config apps/admin-web/wrangler.jsonc --local --persist-to .wrangler/state --file packages/database/tests/local-smoke.sql",
    "db:bootstrap:local": "node scripts/run-tool.mjs wrangler d1 execute cloudflare-ai-blog --config apps/admin-web/wrangler.jsonc --local --persist-to .wrangler/state --file packages/database/local-bootstrap.sql",
    "db:test:management": "node --import ./packages/database/tests/register-types.mjs --test packages/database/tests/management.test.mjs",
    "db:test:posts": "node --import ./packages/database/tests/register-types.mjs --test packages/database/tests/posts.test.mjs",
    "admin:init": "node scripts/init-admin.mjs",
    "admin:create": "node --import ./packages/database/tests/register-types.mjs scripts/create-admin.mjs",
    "auth:test": "node --import ./packages/database/tests/register-types.mjs --test packages/auth/tests/auth.test.mjs",
    "auth:typecheck": "tsc --project packages/auth/tsconfig.json"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "prettier": "3.7.4"
  }
}
