{
  "name": "@cloudflare-ai-blog/blog-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/run-tool.mjs next dev --port 3000",
    "build": "node ../../scripts/run-tool.mjs next build",
    "start": "node ../../scripts/run-tool.mjs next start --port 3000",
    "lint": "eslint",
    "typecheck": "node ../../scripts/run-tool.mjs next typegen && tsc --noEmit",
    "build:worker": "node ../../scripts/run-tool.mjs opennext build",
    "preview": "pnpm run build:worker && pnpm run preview:worker",
    "preview:worker": "node ../../scripts/run-tool.mjs opennext preview --persist-to ../../.wrangler/state",
    "deploy": "pnpm run build:worker && node ../../scripts/run-tool.mjs opennext deploy",
    "cf-typegen": "node ../../scripts/run-tool.mjs wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5",
    "wrangler": "^4.151.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
