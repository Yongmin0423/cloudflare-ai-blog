{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cloudflare-ai-blog-blog",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cloudflare-ai-blog-blog",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "dev": {
    "port": 8787,
    "inspector_port": 9230,
  },
  "account_id": "dc37191a546fa5040fee47c2cc936211",
  "vars": {
    "PUBLIC_SITE_URL": "",
    "PUBLIC_BLOG_ID": "10000000-0000-4000-8000-000000000001",
  },
  "r2_buckets": [
    {
      "binding": "BLOG_MEDIA",
      "bucket_name": "cloudflare-ai-blog-media",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-ai-blog",
      "database_id": "457e1d1c-046f-4f9e-a723-1fea0fc9f61b",
      "migrations_dir": "../../packages/database/migrations",
    },
  ],
}
