{
  "name": "@cloudflare-ai-blog/admin-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/run-tool.mjs next dev --port 3001",
    "build": "node ../../scripts/run-tool.mjs next build",
    "start": "node ../../scripts/run-tool.mjs next start --port 3001",
    "lint": "eslint",
    "typecheck": "node ../../scripts/run-tool.mjs next typegen && tsc --noEmit",
    "build:worker": "node ../../scripts/run-tool.mjs opennext build",
    "preview": "pnpm run build:worker && pnpm run preview:worker",
    "preview:worker": "node ../../scripts/run-tool.mjs opennext preview --persist-to ../../.wrangler/state",
    "deploy": "pnpm run build:worker && node ../../scripts/run-tool.mjs opennext deploy",
    "cf-typegen": "node ../../scripts/run-tool.mjs wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "better-auth": "^1.7.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "6.2.15",
    "lucide-react": "^1.66.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "wrangler": "^4.151.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
